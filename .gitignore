# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Generated deliverables — the whole point is that these are produced fresh.
# If you want to keep one, move it out of the repo.
output/
out/
*.pptx
*.docx
*.pdf
!shared/templates/**/*.docx
!shared/templates/**/*.pptx

# Local API keys. Never commit these.
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Workshop participant work — teams generate a lot of this and none of it
# belongs in the upstream repository.
workshop/participant-output/

# Local runs and model weights
outputs/
*.wav
*.mp3
*.pt

# Packaged agent uploads — rebuild with scripts/package_skills.py
dist/

# Datasets live in github.com/Open-Medical-Affairs/Data-Sources. Clone it here:
#   git clone https://github.com/Open-Medical-Affairs/Data-Sources.git Data-Sources
/Data-Sources
