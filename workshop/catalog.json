{
  "version": "0.2.0",
  "default_mission": "field-insights",
  "default_ta": "oncology-mm",
  "mode": "synthetic workshop; public evidence is separate optional context",
  "missions": [
    {
      "id": "field-insights",
      "title": "What should leadership know?",
      "objective": "Find the three most consequential field insights. Preserve safety findings, contradictions and source IDs. Recommend a concrete next action for each.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/field-observations.csv",
        "Data-Sources/synthetic/{ta}/medical-plan.md",
        "Data-Sources/synthetic/{ta}/product-profile.md"
      ],
      "skills": [
        "field-insight-synthesis",
        "executive-briefing"
      ],
      "deliverables": [
        "Leadership brief",
        "Insight table with source records",
        "Simulated safety escalation and missing-information list"
      ]
    },
    {
      "id": "kol-meeting",
      "title": "Prepare for the difficult meeting",
      "objective": "Prepare for the first expert in the supplied KOL dossiers. Address unresolved questions honestly and propose useful questions for scientific exchange.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/kol-dossiers.md",
        "Data-Sources/synthetic/{ta}/interaction-notes.md",
        "Data-Sources/synthetic/{ta}/product-profile.md",
        "Data-Sources/synthetic/{ta}/evidence-landscape.md"
      ],
      "skills": [
        "kol-engagement-brief"
      ],
      "deliverables": [
        "Two-page meeting brief",
        "Questions, source links and unresolved evidence"
      ]
    },
    {
      "id": "congress",
      "title": "What changed after congress?",
      "objective": "Compare the congress findings to the existing medical plan. Explain what changes, what does not, and why.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/congress-abstracts.md",
        "Data-Sources/synthetic/{ta}/competitor-announcements.md",
        "Data-Sources/synthetic/{ta}/medical-plan.md",
        "Data-Sources/synthetic/{ta}/product-profile.md"
      ],
      "skills": [
        "congress-intelligence",
        "competitive-intelligence"
      ],
      "deliverables": [
        "Congress readout",
        "Change recommendations with evidence limitations"
      ]
    },
    {
      "id": "medical-information",
      "title": "Handle the enquiry queue",
      "objective": "Triage the enquiries, surface potential safety issues and draft responses supported by the fictional sources. Do not infer other-country approval or send responses.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/medical-information-enquiries.csv",
        "Data-Sources/synthetic/{ta}/product-profile.md",
        "Data-Sources/synthetic/{ta}/structured-evidence-table.csv"
      ],
      "skills": [
        "medical-information-response"
      ],
      "deliverables": [
        "Triage register",
        "Draft response and gap log",
        "Simulated safety routing"
      ]
    },
    {
      "id": "evidence-investment",
      "title": "Choose what to fund",
      "objective": "Choose an evidence portfolio within a GBP 2 million ceiling. Evaluate duplication, dependencies and what must be declined or deferred.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/iis-proposal.md",
        "Data-Sources/synthetic/{ta}/rwe-study-concept.md",
        "Data-Sources/synthetic/{ta}/integrated-evidence-plan.csv",
        "Data-Sources/synthetic/{ta}/payer-hta-brief.md",
        "Data-Sources/synthetic/{ta}/evidence-landscape.md"
      ],
      "skills": [
        "integrated-evidence-plan",
        "investigator-initiated-study-review",
        "real-world-evidence-design"
      ],
      "deliverables": [
        "Investment decision workbook or CSV",
        "Committee brief with trade-offs"
      ]
    },
    {
      "id": "publication",
      "title": "Keep every scientific output consistent",
      "objective": "Review the manuscript and reconcile reported values with the supplied study sources. Create an abstract, one honest figure and a plain-language summary with a discrepancy log.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/manuscript-draft.md",
        "Data-Sources/synthetic/{ta}/structured-evidence-table.csv",
        "Data-Sources/synthetic/{ta}/patient-level-analysis.csv",
        "Data-Sources/synthetic/{ta}/abstract-poster-brief.md",
        "Data-Sources/synthetic/{ta}/plain-language-source.md",
        "Data-Sources/synthetic/{ta}/product-profile.md"
      ],
      "skills": [
        "scientific-manuscript",
        "congress-abstract-and-poster",
        "data-visualization-for-medical",
        "plain-language-summary"
      ],
      "deliverables": [
        "Revised manuscript draft",
        "Abstract and figure",
        "Lay summary",
        "Cross-output discrepancy log"
      ]
    },
    {
      "id": "advisory-board",
      "title": "Design an advisory board worth holding",
      "objective": "Identify five unanswered questions that justify an advisory board and prepare the briefing materials. Explain if the evidence does not justify a proposed question.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/advisory-board-transcript.md",
        "Data-Sources/synthetic/{ta}/field-observations.csv",
        "Data-Sources/synthetic/{ta}/evidence-landscape.md",
        "Data-Sources/synthetic/{ta}/kol-dossiers.md",
        "Data-Sources/synthetic/{ta}/product-profile.md"
      ],
      "skills": [
        "advisory-board-design",
        "evidence-gap-analysis",
        "medical-slide-deck"
      ],
      "deliverables": [
        "Board charter and discussion guide",
        "Pre-read deck or structured equivalent",
        "Advisor briefs"
      ]
    },
    {
      "id": "launch-readiness",
      "title": "Can the medical team launch?",
      "objective": "Assess launch readiness without averaging a critical dependency into a green score. Prepare a remediation plan and leadership readout.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/launch-readiness-register.md",
        "Data-Sources/synthetic/{ta}/medical-information-enquiries.csv",
        "Data-Sources/synthetic/{ta}/mlr-review-comments.md",
        "Data-Sources/synthetic/{ta}/scientific-platform-draft.md",
        "Data-Sources/synthetic/{ta}/integrated-evidence-plan.csv"
      ],
      "skills": [
        "launch-medical-readiness",
        "mlr-review-readiness"
      ],
      "deliverables": [
        "Gate assessment",
        "Remediation tracker",
        "Leadership brief"
      ]
    },
    {
      "id": "connected-planning",
      "title": "Work across a practice CRM and content library",
      "objective": "Use the linked records to prioritize account coverage and content needs for the selected therapeutic area. Respect channel preferences, capacity, evidence and review status.",
      "inputs": [
        "Data-Sources/synthetic/connected/hcps.csv",
        "Data-Sources/synthetic/connected/accounts.csv",
        "Data-Sources/synthetic/connected/interactions.csv",
        "Data-Sources/synthetic/connected/content_assets.csv",
        "Data-Sources/synthetic/connected/engagement.csv",
        "Data-Sources/synthetic/connected/data-dictionary.json",
        "Data-Sources/synthetic/{ta}/product-profile.md"
      ],
      "skills": [
        "data-connection",
        "field-medical-planning",
        "medical-content-operations"
      ],
      "deliverables": [
        "Account priorities",
        "Content review queue",
        "Metric definitions and limitations"
      ]
    },
    {
      "id": "patient-partnership",
      "title": "Bring patient priorities into the plan",
      "objective": "Design an accessible listening and co-creation activity for the selected therapeutic area. Link patient priorities to decisions and respect quotation permissions.",
      "inputs": [
        "Data-Sources/synthetic/connected/patient_partnerships.csv",
        "Data-Sources/synthetic/{ta}/plain-language-source.md",
        "Data-Sources/synthetic/{ta}/medical-education-needs.md",
        "Data-Sources/synthetic/{ta}/evidence-landscape.md"
      ],
      "skills": [
        "patient-engagement-planning",
        "plain-language-summary"
      ],
      "deliverables": [
        "Accessible participation plan",
        "Discussion guide",
        "Feedback-to-decision table"
      ]
    },
    {
      "id": "transcript",
      "title": "Turn a meeting transcript into action",
      "objective": "Review the supplied transcript, preserve uncertain medical terms and safety verbatims, then identify decisions and unanswered questions. Clearly state that audio was not supplied.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/advisory-board-transcript.md",
        "Data-Sources/synthetic/{ta}/product-profile.md"
      ],
      "skills": [
        "meeting-transcription",
        "field-insight-synthesis"
      ],
      "deliverables": [
        "Reviewed transcript and correction queue",
        "Decision and follow-up log"
      ]
    },
    {
      "id": "thirty-day-capstone",
      "title": "Run the next 30 days of Medical Affairs",
      "objective": "Prepare a coordinated 30-day draft plan for the selected fictional product. Prioritize evidence, field actions and content within the supplied constraints. Deliver a leadership brief, action tracker and scientific briefing, with source dependencies so new evidence can update affected work.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/medical-plan.md",
        "Data-Sources/synthetic/{ta}/product-profile.md",
        "Data-Sources/synthetic/{ta}/field-observations.csv",
        "Data-Sources/synthetic/{ta}/evidence-landscape.md",
        "Data-Sources/synthetic/{ta}/integrated-evidence-plan.csv",
        "Data-Sources/synthetic/{ta}/launch-readiness-register.md",
        "Data-Sources/synthetic/connected/content_assets.csv",
        "Data-Sources/synthetic/connected/projects.csv"
      ],
      "skills": [
        "medical-strategy-plan",
        "field-insight-synthesis",
        "integrated-evidence-plan",
        "medical-content-operations",
        "executive-briefing",
        "medical-slide-deck"
      ],
      "deliverables": [
        "Leadership brief",
        "30-day action tracker",
        "Scientific briefing",
        "Source dependencies and change log"
      ]
    },
    {
      "id": "msl-pre-call",
      "title": "Prepare the MSL pre-call brief",
      "objective": "Select an HCP with existing interactions in the selected therapeutic area. Gather prior scientific questions, open tasks and access context, then prepare a one-page pre-call brief. Do not invent meeting facts.",
      "inputs": [
        "Data-Sources/synthetic/connected/hcps.csv",
        "Data-Sources/synthetic/connected/interactions.csv",
        "Data-Sources/synthetic/connected/access_log.csv",
        "Data-Sources/synthetic/connected/msl_tasks.csv",
        "Data-Sources/synthetic/connected/data-dictionary.json",
        "Data-Sources/synthetic/{ta}/product-profile.md"
      ],
      "skills": [
        "msl-pre-call-planning"
      ],
      "deliverables": [
        "One-page pre-call brief",
        "Source context and open questions",
        "Material and logistics check"
      ]
    },
    {
      "id": "hcp-access",
      "title": "Identify scientific coverage and access gaps",
      "objective": "Use the fictional professional and account records to identify scientific coverage gaps and appropriate access routes. Respect declined contact and distinguish unverified access. Do not search for fictional people online.",
      "inputs": [
        "Data-Sources/synthetic/connected/hcps.csv",
        "Data-Sources/synthetic/connected/interactions.csv",
        "Data-Sources/synthetic/connected/access_log.csv",
        "Data-Sources/synthetic/connected/msl_tasks.csv",
        "Data-Sources/synthetic/connected/data-dictionary.json",
        "Data-Sources/synthetic/connected/accounts.csv"
      ],
      "skills": [
        "hcp-discovery-and-access",
        "field-medical-planning"
      ],
      "deliverables": [
        "Candidate/coverage register",
        "Institution-aware access plan",
        "Draft introduction for review"
      ]
    },
    {
      "id": "msl-post-call",
      "title": "Turn the call notes into useful follow-up",
      "objective": "Use the actual supplied historical notes to create a factual CRM draft and follow-up queue. Separate statements from inferences, preserve unresolved fields and identify simulated safety intake. Do not invent a new meeting.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/interaction-notes.md",
        "Data-Sources/synthetic/{ta}/product-profile.md",
        "Data-Sources/synthetic/connected/msl_tasks.csv"
      ],
      "skills": [
        "msl-post-call-follow-up"
      ],
      "deliverables": [
        "CRM note draft",
        "Commitment and gap register",
        "Follow-up correspondence draft"
      ]
    },
    {
      "id": "msl-admin",
      "title": "Clear the administrative queue",
      "objective": "Prepare a source-backed MSL administrative queue for the selected therapeutic area: open tasks, overdue items, access checks and next pre-call preparation. Use the scenario date of 1 October 2026. Do not claim tasks were completed or CRM records updated.",
      "inputs": [
        "Data-Sources/synthetic/connected/hcps.csv",
        "Data-Sources/synthetic/connected/interactions.csv",
        "Data-Sources/synthetic/connected/access_log.csv",
        "Data-Sources/synthetic/connected/msl_tasks.csv",
        "Data-Sources/synthetic/connected/data-dictionary.json"
      ],
      "skills": [
        "msl-administrative-operations"
      ],
      "deliverables": [
        "Prioritized task queue",
        "Draft records with source IDs",
        "Weekly status brief"
      ]
    },
    {
      "id": "launch-plan-swarm",
      "title": "Build the whole medical launch plan",
      "objective": "Act as the Launch Lead for the selected fictional product's proposed label expansion. Build the launch facts sheet and six-month question list, staff an org chart of digital workers (one per launch workstream, each with its own context packet), run them in waves with human decision gates, integrate the joins, and finish with an independent readiness verdict that is allowed to be 'not ready'. Every gap carries a named human owner and a date.",
      "inputs": [
        "Data-Sources/synthetic/{ta}/product-profile.md",
        "Data-Sources/synthetic/{ta}/medical-plan.md",
        "Data-Sources/synthetic/{ta}/evidence-landscape.md",
        "Data-Sources/synthetic/{ta}/launch-readiness-register.md",
        "Data-Sources/synthetic/{ta}/integrated-evidence-plan.csv",
        "Data-Sources/synthetic/{ta}/scientific-platform-draft.md",
        "Data-Sources/synthetic/{ta}/publication-plan.md",
        "Data-Sources/synthetic/{ta}/field-account-plan.csv",
        "Data-Sources/synthetic/{ta}/medical-information-enquiries.csv",
        "Data-Sources/synthetic/{ta}/safety-case-series.md",
        "Data-Sources/synthetic/{ta}/payer-hta-brief.md",
        "Data-Sources/synthetic/{ta}/guideline-landscape.md",
        "Data-Sources/synthetic/{ta}/medical-education-needs.md"
      ],
      "skills": [
        "medical-launch-plan",
        "launch-timeline-and-governance",
        "launch-field-training",
        "launch-medical-readiness"
      ],
      "deliverables": [
        "Integrated launch plan with org chart and workstream plans",
        "Critical path, gate criteria and RACI",
        "Six-month question list with routes",
        "Independent readiness verdict and gap register",
        "Leadership deck"
      ]
    }
  ],
